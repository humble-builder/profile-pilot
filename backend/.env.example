OPENAI_API_KEY=your_key_here
# Initial defaults; post-install model settings are persisted through the admin API.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
# Optional; supported only by text-embedding-3 models
OPENAI_EMBEDDING_DIMENSIONS=
OPENAI_EMBEDDING_BATCH_SIZE=100
OPENAI_EMBEDDING_TIMEOUT_MS=30000
ADMIN_API_TOKEN=replace_with_a_long_random_value
PORT=your_port_here
TAVILY_API_KEY=your_tavily_api_key_here
MONGO_URI=mongodb://127.0.0.1:27017
DATA_DIR=../documents/ingestables
UPLOAD_DIR=../documents/downloadables
DEBUG_DEDUP=false
DEBUG_RETRIEVAL=false
DEBUG_PROMPT=false
DEBUG_WEB_SEARCH=false
DEBUG_FUSION=false
DEBUG_THRESHOLD=false
DEBUG_RERANK=false
DEBUG_INTENT=false
