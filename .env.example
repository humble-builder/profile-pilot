OPENAI_API_KEY=your_openai_api_key
# Reserved for the V2 gateway. Official V1 releases make no Tavily API calls.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=false

# Release tooling supplies immutable image digests. Installer users should not edit these.
PROFILEPILOT_BACKEND_IMAGE=ghcr.io/humble-builder/profile-pilot-backend@sha256:release_digest
PROFILEPILOT_FRONTEND_IMAGE=ghcr.io/humble-builder/profile-pilot-frontend@sha256:release_digest
PROFILEPILOT_MONGO_IMAGE=mongo@sha256:release_digest

# Initial defaults; post-install model settings are persisted through the admin API.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_EMBEDDING_DIMENSIONS=
OPENAI_EMBEDDING_BATCH_SIZE=100
OPENAI_EMBEDDING_TIMEOUT_MS=30000

# Required by NextAuth. Generate a long random value for AUTH_SECRET.
AUTH_SECRET=replace_with_a_long_random_value
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
ADMIN_EMAIL=your_google_account_email
ADMIN_API_TOKEN=installer_generated_random_value

FRONTEND_PORT=3000
