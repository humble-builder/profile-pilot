OPENAI_API_KEY=your_openai_api_key
# Reserved for the V2 gateway. Official V1 releases make no Tavily API calls.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=false

# Initial defaults; runtime model settings are persisted through the admin API.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_EMBEDDING_DIMENSIONS=
OPENAI_EMBEDDING_BATCH_SIZE=100
OPENAI_EMBEDDING_TIMEOUT_MS=30000

# Required by NextAuth. Generate a long random value for AUTH_SECRET.
AUTH_SECRET=replace_with_a_long_random_value
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
ADMIN_EMAIL=your_google_account_email
# Generate a separate long random value for server-to-server admin requests.
ADMIN_API_TOKEN=replace_with_a_long_random_value

FRONTEND_PORT=3000
